# Geneva Purpose Field
ARBITER_EMBED_URL=https://api.arbiter.traut.ai/public/embed
PURPOSE_FIELD_HOST=127.0.0.1
PURPOSE_FIELD_PORT=8844
PURPOSE_FIELD_DB=./data/purpose_field.sqlite3

# Optional local write protection for Build Field and Add Source actions.
PURPOSE_FIELD_API_KEY=

# Crawl and embedding controls.
PURPOSE_FIELD_HTTP_TIMEOUT=35
PURPOSE_FIELD_EMBED_TIMEOUT=60
PURPOSE_FIELD_EMBED_BATCH_SIZE=16
PURPOSE_FIELD_EMBED_WORKERS=4
PURPOSE_FIELD_CRAWL_DELAY=0.10

# Leave at 0 unless the local Python installation cannot validate TLS certificates.
PURPOSE_FIELD_INSECURE_SSL=0
